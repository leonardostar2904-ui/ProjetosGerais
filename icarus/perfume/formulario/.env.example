# Copie para .env.local (no computador) ou cadastre na Vercel: Settings, Environment Variables.
# Nada aqui vai para o navegador: só a rota /api/criacao lê estas variáveis.

# IA de criação (obrigatória para a leitura aparecer). Chave em https://platform.claude.com
ANTHROPIC_API_KEY=

# Supabase (obrigatório para gravar as respostas e a proposta). Project Settings, API.
# Use a chave secreta (service_role ou sb_secret_...). Nunca a publique nem use NEXT_PUBLIC_ nela.
SUPABASE_URL=https://lusjmesjjypesvgxokqp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Opcionais
# ICARUS_IA_MODELO=claude-opus-5-5      # para gastar menos: claude-sonnet-5-5
# ICARUS_IA_ESFORCO=medium              # low, medium, high, xhigh ou max
# ICARUS_IA_BUSCAS_MAX=4                # buscas na web por criação (0 desliga)
# ICARUS_IA_LIMITE_DIARIO=40            # teto de criações por dia (só vale com o Supabase ligado)
# ICARUS_IA_TEMPO_MAX=270               # segundos; a função da Vercel vai até 300
